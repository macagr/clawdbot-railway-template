{
  "$id": "usage.json",
  "title": "Usage meter",
  "type": "object",
  "additionalProperties": false,
  "required": ["calls", "totals"],
  "properties": {
    "calls": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "role", "input_tokens", "output_tokens", "cost"],
        "properties": {
          "at": { "$ref": "common.json#/$defs/timestamp" },
          "turn": { "$ref": "common.json#/$defs/opaqueId" },
          "role": { "$ref": "common.json#/$defs/id" },
          "model": { "type": "string", "maxLength": 200 },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "cached_tokens": { "type": "integer", "minimum": 0 },
          "cost": { "type": "number", "minimum": 0 },
          "estimated": { "type": "boolean" }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cost", "input_tokens", "output_tokens"],
      "properties": {
        "cost": { "type": "number", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "by_day": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "by_month": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "by_role": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
      }
    }
  }
}
