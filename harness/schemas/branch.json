{
  "$id": "branch.json",
  "title": "Branch metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "base_revision", "created_at", "status"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/id" },
    "label": { "type": "string", "maxLength": 200 },
    "base_revision": { "$ref": "common.json#/$defs/revision" },
    "created_at": { "$ref": "common.json#/$defs/timestamp" },
    "status": { "enum": ["active", "discarded", "promoted", "exported"] },
    "note": { "$ref": "common.json#/$defs/shortText" }
  }
}
