{
  "$id": "form-ledger.json",
  "title": "Form/shape ledger (recency-weighted usage per dimension)",
  "type": "object",
  "additionalProperties": false,
  "required": ["decay", "scores", "history"],
  "properties": {
    "decay": { "type": "number", "minimum": 0, "maximum": 1 },
    "scores": {
      "type": "object",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
    },
    "history": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn", "form"],
        "properties": {
          "turn": { "$ref": "common.json#/$defs/opaqueId" },
          "form": { "$ref": "director-packet.json#/$defs/form" },
          "pressure_seen": { "type": "object" }
        }
      }
    }
  }
}
